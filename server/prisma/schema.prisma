generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  role         Role     @default(ATTENDEE)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens   RefreshToken[]
  organizedEvents Event[]        @relation("EventOrganizer")
  moderatedEvents Event[]        @relation("EventModerator")
  bookings        Booking[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUND_REQUIRED
  REFUNDED
}

enum PaymentStatus {
  OPEN
  PAID
  EXPIRED
  REFUND_REQUIRED
  REFUNDED
}

model Event {
  id                   String      @id @default(uuid()) @db.Uuid
  organizerId          String      @db.Uuid
  title                String      @db.VarChar(150)
  description          String      @db.VarChar(5000)
  category             String      @db.VarChar(50)
  coverKey             String?     @db.VarChar(100)
  venue                String      @db.VarChar(150)
  address              String      @db.VarChar(300)
  city                 String      @db.VarChar(100)
  timezone             String      @db.VarChar(64)
  startAt              DateTime    @db.Timestamptz(3)
  endAt                DateTime    @db.Timestamptz(3)
  registrationClosesAt DateTime    @db.Timestamptz(3)
  capacity             Int
  priceMinor           Int
  currency             String      @db.Char(3)
  status               EventStatus @default(DRAFT)
  cancelledAt          DateTime?   @db.Timestamptz(3)
  cancelReason         String?     @db.VarChar(500)
  hiddenAt             DateTime?   @db.Timestamptz(3)
  moderationReason     String?     @db.VarChar(500)
  moderatedById        String?     @db.Uuid
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  organizer   User      @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  moderatedBy User?     @relation("EventModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  bookings    Booking[]

  @@index([status, startAt])
  @@index([organizerId, createdAt])
}

// One active booking per user and event is enforced by a partial unique index
// in the SQL migration.
model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  eventId       String        @db.Uuid
  status        BookingStatus
  amountMinor   Int
  currency      String        @db.Char(3)
  eventSnapshot Json
  holdExpiresAt DateTime?     @db.Timestamptz(3)
  ticketCode    String?       @unique @db.VarChar(64)
  checkedInAt   DateTime?     @db.Timestamptz(3)
  cancelledAt   DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payment Payment?

  @@index([userId, createdAt])
  @@index([eventId, status])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  bookingId          String        @unique @db.Uuid
  provider           String        @db.VarChar(30)
  providerCheckoutId String?       @unique
  providerPaymentId  String?       @unique
  status             PaymentStatus @default(OPEN)
  amountMinor        Int
  currency           String        @db.Char(3)
  refundReference    String?
  lastErrorCode      String?       @db.VarChar(100)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
}

model ProcessedWebhook {
  provider        String   @db.VarChar(30)
  providerEventId String
  processedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@id([provider, providerEventId])
}
